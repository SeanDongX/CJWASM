// String ==/!= 结构比较回归（w52a）
// cjc 语义：String 的 ==/!= 按内容（UTF-8 字节）比较，而非比较堆指针。
// 返回 0 表示全部断言通过；任一失败 +1，最终返回非 0。
//
// 覆盖形态：字面量vs字面量、字面量vs插值、插值vs字面量、堆串vs堆串、
// 空串、前缀相同长度不同、多字节同内容、不同内容、多字节不同内容。

main(): Int64 {
    var fails = 0
    let word = "中"

    // 1. 字面量 vs 字面量（同内容）
    if (!("abc" == "abc")) { fails += 1 }
    // 2. 字面量 vs 插值（堆串）
    if (!("前中后" == "前${word}后")) { fails += 1 }
    // 3. 插值 vs 字面量
    if (!("前${word}后" == "前中后")) { fails += 1 }
    // 4. 堆串 vs 堆串（两次 concat 同内容）
    let h1 = "前" + word + "后"
    let h2 = "前" + word + "后"
    if (!(h1 == h2)) { fails += 1 }
    // 5. 空串
    let e1 = "" + ""
    let e2 = ""
    if (!(e1 == e2)) { fails += 1 }
    // 6. 前缀相同但长度不同
    if ("abc" == "ab") { fails += 1 }
    // 7. 多字节同内容
    if (!(("中" + "文") == "中文")) { fails += 1 }
    // 8. 不同内容
    if ("abc" == "abd") { fails += 1 }
    // 9. 多字节不同内容、同字节长度
    if ("中" == "文") { fails += 1 }
    // 10. != 语义
    if (!("abc" != "abd")) { fails += 1 }
    if ("前${word}后" != "前中后") { fails += 1 }

    fails  // 预期输出: 0
}
